# Local / optional OpenAI (not used by eval runner baseline)
OPENAI_API_KEY=

# Azure OpenAI — required for --adapter azure_openai
# From portal: ay186mnc-1561-resource → Keys and Endpoint (westus3)
AZURE_OPENAI_ENDPOINT=https://ay186mnc-1561-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=<paste-your-key-here>
AZURE_OPENAI_DEPLOYMENT=pc-lab-cheap
AZURE_OPENAI_API_VERSION=2024-08-01-preview
# Live routing ignores cheap. Compiler uses best; classify uses strong then escalates.
AZURE_OPENAI_STRONG_DEPLOYMENT=pc-lab-strong
AZURE_OPENAI_BEST_DEPLOYMENT=pc-lab-best
AZURE_PROMISE_COMPILER_DEPLOYMENT=pc-lab-best
AZURE_CLASSIFIER_DEPLOYMENT=pc-lab-strong
# POST /research-app uses best then strong. Play page fetch + Azure counsel. Cached on phone.

# Azure Speech — voice promise input (POST /transcribe-promise)
# Resource: phonecodex-speech-dev (SpeechServices) in phonecodex-dev / eastus2
# Endpoint pattern: https://phonecodex-speech-dev.cognitiveservices.azure.com/
# Paste key from portal locally into .env only — never commit.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus2
AZURE_SPEECH_ENDPOINT=https://phonecodex-speech-dev.cognitiveservices.azure.com/
AZURE_SPEECH_LANGUAGE=en-IN
# Set to 1 for local/tests without calling Azure
SPEECH_TRANSCRIBE_MOCK=

# Closed-beta phone auth. Empty = local USB/dev is open. Never commit a real value.
STRLIX_BACKEND_APP_SECRET=
# Phone BuildConfig override lives in local.properties: strlix.backendUrl / strlix.backendSecret


# 10-day vision experiment (advisory frames only). Set 1 locally to consume credits.
# Leave unset to reject images. Never commit a real .env.
# Existing deployment on ay186mnc-1561-resource — do not create a new Azure resource.
AZURE_VISION_EXPERIMENT=
# gpt-6-astra on the existing resource — video/frame counsel, not a silent stream.
AZURE_VISION_DEPLOYMENT=pc-lab-astra
AZURE_VISION_FALLBACKS=pc-lab-vision,pc-lab-best,pc-lab-strong
