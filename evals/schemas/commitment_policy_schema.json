{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phonecodex.app/evals/commitment-policy.schema.json",
  "title": "PhoneCodexCommitmentPolicy",
  "description": "Structured output of the Promise Compiler — turns natural-language user promises into enforceable policy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "commitmentType",
    "duration",
    "startCondition",
    "strictnessLevel",
    "allowedApps",
    "blockedApps",
    "allowedContent",
    "blockedContent",
    "activeGuardrails",
    "quotas",
    "strikePolicy",
    "lockPolicy",
    "emergencyExceptions",
    "tamperPolicy",
    "followUpQuestionRequired",
    "followUpQuestion",
    "rejectedUnsafeParts",
    "confidence"
  ],
  "properties": {
    "commitmentType": {
      "type": "string",
      "enum": [
        "focus_session",
        "quota_entertainment",
        "time_threshold",
        "permanent_guardrail",
        "monk_mode",
        "install_gate",
        "emergency_override"
      ]
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value", "unit", "until"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["fixed", "until_clock", "indefinite", "none"]
        },
        "value": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "unit": {
          "type": ["string", "null"],
          "enum": ["minutes", "hours", "days", "years", null]
        },
        "until": {
          "type": ["string", "null"],
          "description": "Clock time HH:MM or ISO date when kind=until_clock"
        }
      }
    },
    "startCondition": {
      "type": "string",
      "enum": ["immediate", "scheduled", "on_next_unlock", "manual_confirm"]
    },
    "strictnessLevel": {
      "type": "string",
      "enum": ["SOFT", "SMART", "STRICT", "LOCKED"]
    },
    "allowedApps": {
      "type": "array",
      "items": { "$ref": "#/$defs/appRule" }
    },
    "blockedApps": {
      "type": "array",
      "items": { "$ref": "#/$defs/appRule" }
    },
    "allowedContent": {
      "type": "array",
      "items": { "$ref": "#/$defs/contentRule" }
    },
    "blockedContent": {
      "type": "array",
      "items": { "$ref": "#/$defs/contentRule" }
    },
    "activeGuardrails": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "no_adult_content",
          "no_dating_apps",
          "no_gambling",
          "no_short_form_video",
          "no_social_feed",
          "no_entertainment_installs"
        ]
      },
      "uniqueItems": true
    },
    "quotas": {
      "type": "array",
      "items": { "$ref": "#/$defs/quota" }
    },
    "strikePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warnBeforeLock", "strikesBeforeLock", "resetPeriod"],
      "properties": {
        "warnBeforeLock": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of WARN decisions before counting a strike"
        },
        "strikesBeforeLock": {
          "type": "integer",
          "minimum": 0
        },
        "resetPeriod": {
          "type": "string",
          "enum": ["session", "day", "never"]
        }
      }
    },
    "lockPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "durationMinutes", "scope"],
      "properties": {
        "enabled": { "type": "boolean" },
        "durationMinutes": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "scope": {
          "type": "string",
          "enum": ["app", "device_overlay", "commitment_pause"]
        }
      }
    },
    "emergencyExceptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/emergencyException" }
    },
    "tamperPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preventDisable", "onTamper", "allowSettingsBrowse"],
      "properties": {
        "preventDisable": { "type": "boolean" },
        "onTamper": {
          "type": "string",
          "enum": ["LOCK", "WARN", "BLOCK", "NONE"]
        },
        "allowSettingsBrowse": { "type": "boolean" }
      }
    },
    "followUpQuestionRequired": { "type": "boolean" },
    "followUpQuestion": { "type": ["string", "null"] },
    "rejectedUnsafeParts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "userFacingConfirmation": {
      "description": "v07/v08: string summary OR structured confirm object (no package IDs). v08 prefers understood/allowed/blocked/time/appliesTo/checkThis/safetyNotes; v07 aliases still accepted.",
      "oneOf": [
        { "type": "null" },
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": true
        }
      ]
    },
    "interpretationNotes": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Promise Semantics v1: expansions such as shorts→all short-form surfaces."
    },
    "cleanedPromiseText": { "type": "string" },
    "recommendedInterpretation": { "type": ["string", "null"] },
    "interpretationConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "ambiguityLevel": {
      "type": "string",
      "enum": ["none", "low", "medium", "high"]
    },
    "clarificationRequired": { "type": "boolean" },
    "clarificationOptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "description": { "type": "string" },
          "recommended": { "type": "boolean" },
          "policyPreview": { "type": ["string", "null"], "description": "v08 preferred" },
          "resultingPolicyPreview": { "type": ["string", "null"], "description": "v07 alias" }
        }
      }
    },
    "detectedLanguage": {
      "type": "string",
      "description": "v08: detected language code or hinglish"
    },
    "transcriptConfidence": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1,
      "description": "v08: voice transcript confidence; null for typed"
    },
    "userIntentSummary": {
      "type": "string",
      "description": "v08: one-sentence intent summary (no package IDs)"
    },
    "alternativeInterpretations": {
      "type": "array",
      "items": { "type": "string" },
      "description": "v08: other plausible readings (no package IDs)"
    },
    "internalPolicy": {
      "type": "object",
      "additionalProperties": true,
      "description": "v08: technical enforcement draft; packages allowed here",
      "properties": {
        "timeWindow": { "type": "object" },
        "surfaceRules": { "type": "array" },
        "contentRules": { "type": "array" },
        "appRules": { "type": "array" },
        "quotaRules": { "type": "array" },
        "recoveryRules": { "type": "object" },
        "guardrails": { "type": "array", "items": { "type": "string" } }
      }
    },
    "riskReview": {
      "type": "object",
      "additionalProperties": true,
      "description": "v08: false-allow / false-block / safety risk review",
      "properties": {
        "falseAllowRisk": {
          "type": "string",
          "enum": ["none", "low", "medium", "high"]
        },
        "falseBlockRisk": {
          "type": "string",
          "enum": ["none", "low", "medium", "high"]
        },
        "safetyRisk": {
          "type": "string",
          "enum": ["none", "low", "medium", "high"]
        },
        "requiresHumanConfirmation": { "type": "boolean" }
      }
    },
    "hiddenInternalScope": {
      "type": "array",
      "items": { "type": "string" },
      "description": "v08: internal-only notes; may include package IDs"
    }
  },
  "$defs": {
    "appRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageName", "appLabel", "scope"],
      "properties": {
        "packageName": { "type": "string" },
        "appLabel": { "type": "string" },
        "scope": {
          "type": "string",
          "description": "Human-readable allowance scope, e.g. calculus_only, dm_college_team_only"
        }
      }
    },
    "contentRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "description"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "study",
            "short_form_video",
            "long_form_video",
            "social_dm",
            "social_feed",
            "adult_sexual",
            "gaming",
            "entertainment",
            "install",
            "calls",
            "other"
          ]
        },
        "description": { "type": "string" },
        "apps": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "quota": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "limit", "period"],
      "description": "Usage budgets use entertainment_minutes/social_minutes/shorts/reels. Per-item media length uses max_item_minutes (block longer) or min_item_minutes (require at least this long). Never use entertainment_minutes for video-length thresholds.",
      "properties": {
        "metric": {
          "type": "string",
          "enum": [
            "shorts",
            "reels",
            "entertainment_minutes",
            "social_minutes",
            "max_item_minutes",
            "min_item_minutes"
          ]
        },
        "limit": { "type": "integer", "minimum": 0 },
        "period": {
          "type": "string",
          "enum": ["session", "day", "week", "item"],
          "description": "Use period=item for max_item_minutes / min_item_minutes thresholds."
        }
      }
    },
    "emergencyException": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "detail"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "family_calls",
            "emergency_calls",
            "whitelist_contacts",
            "whitelist_packages",
            "sos"
          ]
        },
        "detail": { "type": "string" }
      }
    }
  }
}
