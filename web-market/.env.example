# Strlix web-market / market-api payment config
# DEFAULT = free first month + TEST Stripe. Never put sk_live_* or whsec_live_* in git.

# Free month stays on unless BOTH are turned off:
#   STRLIX_BILLING_MODE=test|live     (unprefixed BILLING_MODE also accepted)
#   STRLIX_FREE_LAUNCH_MODE=false     (unprefixed FREE_LAUNCH_MODE also accepted)
STRLIX_BILLING_MODE=free_month
STRLIX_FREE_LAUNCH_MODE=true
STRLIX_FREE_MONTH_DAYS=30
# Optional comma-separated invite codes. Empty = open signup.
STRLIX_INVITE_CODES=
# Placeholder until a custom domain is attached. Legal pages say so.
SUPPORT_EMAIL=support@strlix.app
STRLIX_SUPPORT_EMAIL=support@strlix.app
STRLIX_SUPPORT_EMAIL_PLACEHOLDER=true

# Auth. anon is the demo default. entra is additive and does not disable /v1/auth/anon.
STRLIX_AUTH_MODE=anon
# STRLIX_ENTRA_TENANT_ID=
# STRLIX_ENTRA_CLIENT_ID=
# STRLIX_ENTRA_AUDIENCE=api://strlix-market
# STRLIX_ENTRA_KIND=workforce
# STRLIX_ENTRA_ISSUER=
# STRLIX_ENTRA_JWKS_URI=

STRLIX_PAY_PROVIDER=stripe
STRLIX_PAY_MODE=test

# Triple live gate (ALL required for real Stripe charges):
#   1) STRLIX_PAY_MODE=live
#   2) PAYMENTS_LIVE=true          (unprefixed; also STRLIX_PAYMENTS_LIVE)
#   3) STRLIX_ALLOW_LIVE_CHARGES=true
PAYMENTS_LIVE=false
STRLIX_PAYMENTS_LIVE=false
STRLIX_ALLOW_LIVE_CHARGES=false

# Test keys only below — live keys live in Azure Key Vault (kv-zevi-strlix).
# See infra/hardening/PAYMENTS-KEYVAULT.md
STRLIX_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRLIX_STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRLIX_STRIPE_WEBHOOK_SECRET=whsec_test_REPLACE_ME
STRLIX_RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
STRLIX_RAZORPAY_KEY_SECRET=REPLACE_ME

STRLIX_CHECKOUT_SUCCESS_URL=http://127.0.0.1:8080/market/?paid=1
STRLIX_CHECKOUT_CANCEL_URL=http://127.0.0.1:8080/market/?canceled=1

STRLIX_STREAM_URL=http://127.0.0.1:8789
STRLIX_STREAM_FALLBACK=http://127.0.0.1:8787
STRLIX_STREAM_VM=http://20.115.117.71:8789
