<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Strlix Cloud Phone</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg: #070b14;
      --bg-elev: #0d1320;
      --panel: #121a2b;
      --panel-2: #182235;
      --fg: #eef2ff;
      --muted: #8b9bb8;
      --accent: #5b8cff;
      --accent-2: #7c5cff;
      --accent-glow: rgba(91, 140, 255, 0.35);
      --ok: #34d399;
      --warn: #fbbf24;
      --err: #f87171;
      --user-bg: linear-gradient(135deg, #1e3a6e 0%, #1a2d55 100%);
      --bot-bg: #141e32;
      --border: rgba(148, 163, 184, 0.14);
      --radius: 14px;
      --shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
    }
    * { box-sizing: border-box; }
    html, body { height: 100%; }
    body {
      margin: 0;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, sans-serif;
      background:
        radial-gradient(1200px 600px at 10% -10%, rgba(91, 140, 255, 0.18), transparent 55%),
        radial-gradient(900px 500px at 90% 0%, rgba(124, 92, 255, 0.14), transparent 50%),
        var(--bg);
      color: var(--fg);
      -webkit-font-smoothing: antialiased;
    }

    /* Header */
    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 14px 22px;
      border-bottom: 1px solid var(--border);
      background: rgba(7, 11, 20, 0.72);
      backdrop-filter: blur(12px);
      position: sticky;
      top: 0;
      z-index: 10;
    }
    .brand { display: flex; align-items: center; gap: 12px; min-width: 0; }
    .logo {
      width: 36px; height: 36px; border-radius: 10px;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      display: grid; place-items: center;
      font-weight: 700; font-size: 16px; color: #fff;
      box-shadow: 0 0 0 1px rgba(255,255,255,0.12), 0 6px 18px var(--accent-glow);
      flex-shrink: 0;
    }
    .brand-text h1 {
      margin: 0; font-size: 16px; font-weight: 650; letter-spacing: -0.02em;
    }
    .brand-text p {
      margin: 2px 0 0; font-size: 12px; color: var(--muted);
    }
    .status-bar {
      display: flex; flex-wrap: wrap; gap: 8px; justify-content: flex-end;
    }
    .pill {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 6px 10px; border-radius: 999px;
      background: var(--panel); border: 1px solid var(--border);
      font-size: 12px; color: var(--muted); white-space: nowrap;
    }
    .dot {
      width: 7px; height: 7px; border-radius: 50%;
      background: var(--muted); flex-shrink: 0;
    }
    .dot.ok { background: var(--ok); box-shadow: 0 0 8px rgba(52, 211, 153, 0.6); }
    .dot.warn { background: var(--warn); }
    .dot.err { background: var(--err); }

    /* Layout */
    main {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(280px, 380px);
      height: calc(100vh - 65px);
      max-width: 1400px;
      margin: 0 auto;
    }

    /* Chat */
    #chat {
      display: flex; flex-direction: column;
      border-right: 1px solid var(--border);
      min-height: 0;
    }
    #log {
      flex: 1; overflow: auto; padding: 20px 22px 8px;
      scroll-behavior: smooth;
    }
    .msg {
      display: flex; gap: 10px; margin: 0 0 16px;
      max-width: 820px; animation: fadeUp .28s ease;
    }
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: none; }
    }
    .msg.user { margin-left: auto; flex-direction: row-reverse; }
    .avatar {
      width: 32px; height: 32px; border-radius: 10px;
      display: grid; place-items: center; font-size: 13px; font-weight: 600;
      flex-shrink: 0; margin-top: 2px;
    }
    .msg.user .avatar { background: linear-gradient(135deg, #3b82f6, #6366f1); color: #fff; }
    .msg.assistant .avatar {
      background: var(--panel-2); border: 1px solid var(--border); color: var(--accent);
    }
    .bubble {
      padding: 12px 14px; border-radius: var(--radius);
      line-height: 1.5; font-size: 14px; white-space: pre-wrap; word-break: break-word;
      box-shadow: var(--shadow);
    }
    .msg.user .bubble {
      background: var(--user-bg);
      border: 1px solid rgba(91, 140, 255, 0.35);
      border-bottom-right-radius: 4px;
    }
    .msg.assistant .bubble {
      background: var(--bot-bg);
      border: 1px solid var(--border);
      border-bottom-left-radius: 4px;
    }
    .meta {
      margin-top: 8px; font-size: 11px; color: var(--muted);
      display: flex; flex-wrap: wrap; gap: 6px;
    }
    .chip-meta {
      padding: 2px 8px; border-radius: 999px;
      background: rgba(91, 140, 255, 0.12);
      border: 1px solid rgba(91, 140, 255, 0.22);
      color: #a8c4ff;
    }
    .typing {
      display: inline-flex; gap: 4px; align-items: center; padding: 4px 0;
    }
    .typing span {
      width: 6px; height: 6px; border-radius: 50%; background: var(--muted);
      animation: bounce 1.2s infinite ease-in-out;
    }
    .typing span:nth-child(2) { animation-delay: .15s; }
    .typing span:nth-child(3) { animation-delay: .3s; }
    @keyframes bounce {
      0%, 80%, 100% { transform: translateY(0); opacity: .4; }
      40% { transform: translateY(-4px); opacity: 1; }
    }

    /* Composer */
    .composer-wrap {
      padding: 10px 16px 16px;
      border-top: 1px solid var(--border);
      background: linear-gradient(180deg, transparent, rgba(7, 11, 20, 0.85));
    }
    .suggestions {
      display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 10px;
    }
    .sug {
      appearance: none; border: 1px solid var(--border);
      background: var(--panel); color: var(--fg);
      padding: 7px 12px; border-radius: 999px;
      font: inherit; font-size: 12px; font-weight: 500;
      cursor: pointer; transition: border-color .15s, background .15s, transform .1s;
    }
    .sug:hover {
      border-color: rgba(91, 140, 255, 0.5);
      background: var(--panel-2);
    }
    .sug:active { transform: scale(0.98); }
    form#f {
      display: flex; gap: 10px; align-items: center;
      padding: 8px 8px 8px 14px;
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 16px;
      box-shadow: var(--shadow);
    }
    form#f:focus-within {
      border-color: rgba(91, 140, 255, 0.55);
      box-shadow: 0 0 0 3px var(--accent-glow), var(--shadow);
    }
    #q {
      flex: 1; border: 0; outline: none; background: transparent;
      color: var(--fg); font: inherit; font-size: 14px; padding: 8px 0;
      min-width: 0;
    }
    #q::placeholder { color: var(--muted); }
    #go {
      appearance: none; border: 0; cursor: pointer;
      padding: 10px 16px; border-radius: 12px;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      color: #fff; font: inherit; font-weight: 600; font-size: 13px;
      box-shadow: 0 4px 14px var(--accent-glow);
      transition: opacity .15s, transform .1s;
    }
    #go:hover { opacity: .95; }
    #go:active { transform: scale(0.98); }
    #go:disabled { opacity: .45; cursor: wait; }

    /* Side panel — live phone */
    #side {
      display: flex; flex-direction: column; gap: 12px;
      padding: 16px; overflow: auto; min-height: 0;
      background: rgba(13, 19, 32, 0.55);
    }
    #side h2 {
      margin: 0; font-size: 12px; font-weight: 600;
      letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted);
    }
    .phone-frame {
      position: relative;
      background: #000;
      border-radius: 22px;
      border: 1px solid var(--border);
      box-shadow: var(--shadow), inset 0 0 0 1px rgba(255,255,255,0.04);
      overflow: hidden;
      aspect-ratio: 9 / 19.5;
      max-height: min(72vh, 640px);
      margin: 0 auto;
      width: 100%;
    }
    .phone-frame .notch {
      position: absolute; top: 8px; left: 50%; transform: translateX(-50%);
      width: 28%; height: 10px; border-radius: 999px;
      background: #111; z-index: 2; opacity: .85;
    }
    #liveShot {
      width: 100%; height: 100%; object-fit: contain; display: block;
      background: #05070d;
    }
    .phone-empty {
      position: absolute; inset: 0; display: grid; place-items: center;
      color: var(--muted); font-size: 13px; text-align: center; padding: 24px;
    }
    .phone-empty.hidden { display: none; }
    .shot-meta {
      display: flex; justify-content: space-between; align-items: center;
      font-size: 12px; color: var(--muted);
    }
    .shot-actions { display: flex; gap: 8px; }
    .ghost-btn {
      appearance: none; border: 1px solid var(--border);
      background: var(--panel); color: var(--fg);
      padding: 6px 10px; border-radius: 8px; font: inherit; font-size: 12px;
      cursor: pointer;
    }
    .ghost-btn:hover { border-color: rgba(91, 140, 255, 0.45); }
    .history-shots {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px;
    }
    .history-shots img {
      width: 100%; border-radius: 8px; border: 1px solid var(--border);
      cursor: pointer; aspect-ratio: 9/16; object-fit: cover; background: #000;
      transition: outline .15s;
    }
    .history-shots img:hover { outline: 2px solid var(--accent); }

    .welcome {
      max-width: 520px; margin: 40px auto 24px; text-align: center;
      color: var(--muted); font-size: 14px; line-height: 1.55;
    }
    .welcome strong { color: var(--fg); }

    /* Mobile */
    @media (max-width: 860px) {
      header { flex-direction: column; align-items: flex-start; padding: 12px 14px; }
      .status-bar { width: 100%; justify-content: flex-start; }
      main {
        grid-template-columns: 1fr;
        grid-template-rows: minmax(220px, 38vh) minmax(0, 1fr);
        height: calc(100dvh - 96px);
      }
      #side {
        order: -1; border-bottom: 1px solid var(--border);
        padding: 12px; overflow: hidden;
      }
      .phone-frame {
        max-height: 28vh; aspect-ratio: 9 / 16; border-radius: 16px;
      }
      .history-shots { display: none; }
      #chat { border-right: 0; }
      #log { padding: 14px; }
      .composer-wrap { padding: 8px 12px 12px; }
    }

    /* Live voice session */
    #liveBtn {
      appearance: none; border: 1px solid rgba(91,140,255,0.45);
      background: linear-gradient(135deg, rgba(91,140,255,0.25), rgba(124,92,255,0.25));
      color: #fff; padding: 8px 14px; border-radius: 999px;
      font: inherit; font-size: 12px; font-weight: 600; cursor: pointer;
      display: inline-flex; align-items: center; gap: 8px;
    }
    #liveBtn .pulse {
      width: 8px; height: 8px; border-radius: 50%; background: var(--ok);
      box-shadow: 0 0 8px rgba(52,211,153,.7);
    }
    #liveBtn.active {
      background: linear-gradient(135deg, #ef4444, #b91c1c);
      border-color: rgba(248,113,113,.5);
    }
    #liveBtn.active .pulse { background: #fff; animation: blink 1s infinite; }
    @keyframes blink { 50% { opacity: .35; } }

    #liveOverlay {
      display: none; position: fixed; inset: 0; z-index: 50;
      background: rgba(3,6,14,.82); backdrop-filter: blur(10px);
      align-items: center; justify-content: center; padding: 24px;
    }
    #liveOverlay.open { display: flex; }
    .live-card {
      width: min(520px, 100%); background: var(--panel);
      border: 1px solid var(--border); border-radius: 24px;
      box-shadow: var(--shadow); padding: 28px 24px 22px; text-align: center;
    }
    .live-card h2 { margin: 0 0 6px; font-size: 20px; letter-spacing: -0.02em; }
    .live-card .sub { color: var(--muted); font-size: 13px; margin-bottom: 18px; }
    .wave {
      height: 72px; display: flex; align-items: center; justify-content: center;
      gap: 4px; margin: 12px 0 18px;
    }
    .wave i {
      display: block; width: 4px; border-radius: 4px; background: var(--accent);
      height: 12px; animation: wave 1.1s ease-in-out infinite;
    }
    .wave i:nth-child(2) { animation-delay: .1s; }
    .wave i:nth-child(3) { animation-delay: .2s; }
    .wave i:nth-child(4) { animation-delay: .3s; }
    .wave i:nth-child(5) { animation-delay: .4s; }
    .wave i:nth-child(6) { animation-delay: .15s; }
    .wave i:nth-child(7) { animation-delay: .25s; }
    .wave i:nth-child(8) { animation-delay: .35s; }
    .wave.idle i { animation: none; height: 8px; opacity: .45; }
    .wave.speaking i { background: var(--ok); }
    @keyframes wave {
      0%,100% { height: 10px; }
      50% { height: 56px; }
    }
    #liveTranscript {
      min-height: 48px; color: var(--fg); font-size: 15px; line-height: 1.45;
      margin: 0 0 8px; white-space: pre-wrap;
    }
    #liveReply {
      min-height: 40px; color: var(--muted); font-size: 13px; line-height: 1.45;
      margin: 0 0 16px; white-space: pre-wrap;
    }
    .live-actions { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
    .live-actions button {
      appearance: none; border: 1px solid var(--border); background: var(--panel-2);
      color: var(--fg); padding: 10px 16px; border-radius: 12px;
      font: inherit; font-size: 13px; font-weight: 600; cursor: pointer;
    }
    .live-actions #liveTalk {
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      border: 0; color: #fff;
    }
    .live-actions #liveLeave { color: var(--err); border-color: rgba(248,113,113,.35); }
    #liveMeta { font-size: 11px; color: var(--muted); margin-top: 14px; }


    .live-lang-row {
      display: flex; align-items: center; justify-content: center; gap: 10px;
      margin: 0 0 12px; flex-wrap: wrap;
    }
    .live-lang-row label { font-size: 12px; color: var(--muted); }
    #liveLang {
      appearance: none; background: var(--panel-2); color: var(--fg);
      border: 1px solid var(--border); border-radius: 10px;
      padding: 8px 12px; font: inherit; font-size: 13px; min-width: 180px;
    }
  </style>
</head>
<body>
  <header>
    <div class="brand">
      <div class="logo" aria-hidden="true">S</div>
      <div class="brand-text">
        <h1>Strlix Cloud Phone</h1>
        <p>Chat with Strlix · live Android phone</p>
      </div>
    </div>
    <div class="status-bar" id="statusBar" aria-live="polite">
      <button type="button" id="liveBtn" title="Live voice on this laptop (mic + speakers)"><span class="pulse"></span>Live</button>
      <span class="pill"><span class="dot" id="adbDot"></span><span id="adbLabel">ADB …</span></span>
      <span class="pill"><span class="dot ok"></span><span id="modelLabel">Strlix AI</span></span>
    </div>
  </header>

  <main>
    <section id="chat">
      <div id="log">
        <div class="welcome" id="welcome">
          <strong>Strlix is ready.</strong> No signup — just ask.
          Open Settings, screenshot the home screen, go home, or describe what you see.
        </div>
      </div>
      <div class="composer-wrap">
        <div class="suggestions" id="suggestions">
          <button type="button" class="sug" data-prompt="Open Settings">Open Settings</button>
          <button type="button" class="sug" data-prompt="Take a screenshot of the home screen and describe what you see">Screenshot home</button>
          <button type="button" class="sug" data-prompt="Go home">Go home</button>
        </div>
        <form id="f">
          <input id="q" placeholder="Message Strlix… e.g. Open Settings and describe the screen" autocomplete="off" />
          <button id="go" type="submit">Send</button>
        </form>
      </div>
    </section>

    <aside id="side">
      <div class="shot-meta">
        <h2>Live phone</h2>
        <div class="shot-actions">
          <button type="button" class="ghost-btn" id="refreshShot" title="Grab a fresh screenshot">Refresh</button>
        </div>
      </div>
      <div class="phone-frame">
        <div class="notch" aria-hidden="true"></div>
        <img id="liveShot" alt="" hidden style="display:none" />
        <div class="phone-empty" id="phoneEmpty">Phone preview appears after you send a prompt or tap Refresh</div>
      </div>
      <div class="shot-meta"><span id="shotStamp">—</span><span id="shotCount"></span></div>
      <h2>Recent</h2>
      <div class="history-shots" id="shots"></div>
    </aside>
  </main>

  <script>
    const log = document.getElementById('log');
    const shots = document.getElementById('shots');
    const liveShot = document.getElementById('liveShot');
    const phoneEmpty = document.getElementById('phoneEmpty');
    const shotStamp = document.getElementById('shotStamp');
    const shotCount = document.getElementById('shotCount');
    const welcome = document.getElementById('welcome');
    let history = [];
    let shotN = 0;

    function setLive(url, label) {
      if (!url) return;
      liveShot.hidden = false;
      liveShot.style.display = 'block';
      liveShot.src = url;
      phoneEmpty.classList.add('hidden');
      shotStamp.textContent = label || new Date().toLocaleTimeString();
      shotN += 1;
      shotCount.textContent = shotN + (shotN === 1 ? ' capture' : ' captures');
    }

    function addBubble(role, text, metaChips) {
      if (welcome) welcome.remove();
      const row = document.createElement('div');
      row.className = 'msg ' + role;
      const av = document.createElement('div');
      av.className = 'avatar';
      av.textContent = role === 'user' ? 'You' : 'S';
      const bubble = document.createElement('div');
      bubble.className = 'bubble';
      bubble.textContent = text;
      if (metaChips && metaChips.length) {
        const m = document.createElement('div');
        m.className = 'meta';
        for (const c of metaChips) {
          const span = document.createElement('span');
          span.className = 'chip-meta';
          span.textContent = c;
          m.appendChild(span);
        }
        bubble.appendChild(m);
      }
      row.appendChild(av);
      row.appendChild(bubble);
      log.appendChild(row);
      log.scrollTop = log.scrollHeight;
      return row;
    }

    function addTyping() {
      const row = document.createElement('div');
      row.className = 'msg assistant';
      row.id = 'typingRow';
      row.innerHTML = '<div class="avatar">S</div><div class="bubble"><div class="typing"><span></span><span></span><span></span></div></div>';
      log.appendChild(row);
      log.scrollTop = log.scrollHeight;
    }
    function clearTyping() {
      const t = document.getElementById('typingRow');
      if (t) t.remove();
    }

    async function refreshHealth() {
      const adbDot = document.getElementById('adbDot');
      const adbLabel = document.getElementById('adbLabel');
      const modelLabel = document.getElementById('modelLabel');
      try {
        const r = await fetch('/health');
        const j = await r.json();
        const state = (j.adb_state || '').toString();
        const connected = state === 'device' || state.includes('device');
        const err = state.startsWith('error') || state === '';
        adbDot.className = 'dot ' + (connected ? 'ok' : err ? 'err' : 'warn');
        adbLabel.textContent = connected
          ? ('Phone connected')
          : ('Phone ' + (state || 'offline'));
        modelLabel.textContent = 'Strlix AI';
      } catch (e) {
        adbDot.className = 'dot err';
        adbLabel.textContent = 'Connection error';
      }
    }
    refreshHealth();
    setInterval(refreshHealth, 15000);

    function pushHistoryShot(url, name) {
      const img = document.createElement('img');
      img.src = url;
      img.alt = name || 'shot';
      img.title = 'Show as live';
      img.addEventListener('click', () => setLive(url, name));
      shots.prepend(img);
      while (shots.children.length > 9) shots.lastChild.remove();
    }

    async function sendMessage(message) {
      const input = document.getElementById('q');
      const btn = document.getElementById('go');
      if (!message) return;
      addBubble('user', message);
      input.value = '';
      btn.disabled = true;
      addTyping();
      try {
        const r = await fetch('/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message, history }),
        });
        const j = await r.json();
        clearTyping();
        if (!r.ok) throw new Error(j.detail || JSON.stringify(j));
        history = j.history || history;
        const tools = (j.tools || []).map(t => t.tool);
        const chips = [];
        if (tools.length) chips.push('tools: ' + tools.join(', '));
        addBubble('assistant', j.reply || '(empty)', chips);
        for (const s of (j.screenshots || [])) {
          const name = (s.path || '').split('/').pop();
          const url = '/demo/' + name + '?t=' + Date.now();
          setLive(url, name);
          pushHistoryShot(url, name);
        }
        refreshHealth();
      } catch (err) {
        clearTyping();
        addBubble('assistant', 'Error: ' + err.message, ['error']);
      } finally {
        btn.disabled = false;
        input.focus();
      }
    }

    document.getElementById('f').addEventListener('submit', (e) => {
      e.preventDefault();
      sendMessage(document.getElementById('q').value.trim());
    });

    document.getElementById('suggestions').addEventListener('click', (e) => {
      const btn = e.target.closest('.sug');
      if (!btn) return;
      sendMessage(btn.dataset.prompt);
    });

    document.getElementById('refreshShot').addEventListener('click', async () => {
      const btn = document.getElementById('refreshShot');
      btn.disabled = true;
      try {
        const r = await fetch('/adb/screenshot', { method: 'POST' });
        const j = await r.json();
        if (!r.ok) throw new Error(j.detail || JSON.stringify(j));
        const name = (j.path || j.url || '').split('/').pop();
        const url = (j.url || ('/demo/' + name)) + '?t=' + Date.now();
        setLive(url, name);
        pushHistoryShot(url, name);
        refreshHealth();
      } catch (err) {
        shotStamp.textContent = 'Refresh failed: ' + err.message;
      } finally {
        btn.disabled = false;
      }
    });

    // ---- Live Voice (laptop is the audio surface) ----
    const liveBtn = document.getElementById('liveBtn');
    const liveOverlay = document.getElementById('liveOverlay');
    const liveWave = document.getElementById('liveWave');
    const liveTranscript = document.getElementById('liveTranscript');
    const liveReply = document.getElementById('liveReply');
    const liveTalk = document.getElementById('liveTalk');
    const liveLeave = document.getElementById('liveLeave');
    const liveMeta = document.getElementById('liveMeta');

    // ---- Language (persisted) ----
    const LANG_KEY = 'strlix.live.language';
    const liveLang = document.getElementById('liveLang');
    let liveLanguage = localStorage.getItem(LANG_KEY) || '';
    const LANG_FALLBACKS = [
      {id:'en-US', name:'English', native:'English'},
      {id:'hi-IN', name:'Hindi', native:'हिन्दी'},
      {id:'es-ES', name:'Spanish', native:'Español'},
      {id:'fr-FR', name:'French', native:'Français'},
      {id:'zh-CN', name:'Mandarin', native:'中文'},
      {id:'ar-SA', name:'Arabic', native:'العربية'},
      {id:'pt-BR', name:'Portuguese', native:'Português'},
      {id:'ja-JP', name:'Japanese', native:'日本語'},
    ];

    function matchDeviceLang(list) {
      const nav = (navigator.language || 'en-US').replace('_','-');
      const ids = list.map(x => x.id);
      if (ids.includes(nav)) return nav;
      const primary = nav.split('-')[0].toLowerCase();
      const map = {en:'en-US',hi:'hi-IN',es:'es-ES',fr:'fr-FR',zh:'zh-CN',ar:'ar-SA',pt:'pt-BR',ja:'ja-JP'};
      if (map[primary] && ids.includes(map[primary])) return map[primary];
      const hit = list.find(x => x.id.toLowerCase().startsWith(primary + '-'));
      return hit ? hit.id : 'en-US';
    }

    function fillLangSelect(list) {
      if (!liveLang) return;
      liveLang.innerHTML = '';
      for (const L of list) {
        const opt = document.createElement('option');
        opt.value = L.id;
        opt.textContent = L.name + (L.native && L.native !== L.name ? (' · ' + L.native) : '');
        liveLang.appendChild(opt);
      }
      if (!liveLanguage || ![...liveLang.options].some(o => o.value === liveLanguage)) {
        liveLanguage = matchDeviceLang(list);
      }
      liveLang.value = liveLanguage;
      localStorage.setItem(LANG_KEY, liveLanguage);
    }
    fillLangSelect(LANG_FALLBACKS);

    if (liveLang) {
      liveLang.addEventListener('change', () => {
        liveLanguage = liveLang.value;
        localStorage.setItem(LANG_KEY, liveLanguage);
        if (recognition) { try { recognition.lang = liveLanguage; } catch(_){} }
        setLiveServer(liveOpen);
        liveMeta.textContent = 'Language → ' + liveLanguage + ' (STT+TTS switch live, no restart)';
        if (liveWs && liveWs.readyState === 1) {
          liveWs.send(JSON.stringify({ type: 'live_state', active: liveOpen, source: 'browser', language: liveLanguage }));
        }
      });
    }

    fetch('/voice/languages').then(r => r.json()).then(j => {
      if (j && j.languages && j.languages.length) fillLangSelect(j.languages);
    }).catch(() => {});

    let liveOpen = false;
    let liveBusy = false;
    let liveWs = null;
    let liveAudio = null;
    let recognition = null;

    function setWave(mode) {
      liveWave.classList.remove('idle', 'speaking');
      if (mode === 'idle') liveWave.classList.add('idle');
      else if (mode === 'speaking') liveWave.classList.add('speaking');
    }

    function playHostAudio(url) {
      if (!url) return;
      try { if (liveAudio) { liveAudio.pause(); liveAudio = null; } } catch (_) {}
      liveAudio = new Audio(url);
      setWave('speaking');
      liveAudio.onended = () => { if (!liveBusy) setWave('idle'); };
      liveAudio.onerror = () => setWave('idle');
      liveAudio.play().catch(err => {
        liveMeta.textContent = 'Playback blocked: ' + err.message + ' (click Talk once to unlock audio)';
        setWave('idle');
      });
    }

    function connectLiveWs() {
      if (liveWs && (liveWs.readyState === 0 || liveWs.readyState === 1)) return;
      const proto = location.protocol === 'https:' ? 'wss' : 'ws';
      liveWs = new WebSocket(proto + '://' + location.host + '/ws/live');
      liveWs.onmessage = (ev) => {
        try {
          const msg = JSON.parse(ev.data);
          if (msg.type === 'speak' && msg.audio_url) {
            if (msg.text) liveReply.textContent = msg.text;
            playHostAudio(msg.audio_url);
          } else if (msg.type === 'hello' && msg.voice) {
            liveMeta.textContent = 'TTS: ' + (msg.voice.provider || '?') +
              ' · ' + (msg.voice.edge_voice || '') +
              ' · clients ' + (msg.clients || 0);
          } else if (msg.type === 'turn') {
            if (msg.user) liveTranscript.textContent = msg.user;
            if (msg.reply) liveReply.textContent = msg.reply;
            if (msg.audio_url) playHostAudio(msg.audio_url);
          }
        } catch (_) {}
      };
      liveWs.onclose = () => { liveWs = null; if (liveOpen) setTimeout(connectLiveWs, 1500); };
    }

    async function setLiveServer(active) {
      try {
        await fetch('/voice/live', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ active, source: 'browser', language: liveLanguage }),
        });
      } catch (_) {}
    }

    function enterLive() {
      liveOpen = true;
      liveOverlay.classList.add('open');
      liveBtn.classList.add('active');
      liveBtn.innerHTML = '<span class="pulse"></span>Leave Live';
      setWave('idle');
      liveTranscript.textContent = 'Tap Talk and speak…';
      liveReply.textContent = '';
      connectLiveWs();
      setLiveServer(true);
    }

    function leaveLive() {
      liveOpen = false;
      liveOverlay.classList.remove('open');
      liveBtn.classList.remove('active');
      liveBtn.innerHTML = '<span class="pulse"></span>Live';
      stopRecognition();
      try { if (liveAudio) liveAudio.pause(); } catch (_) {}
      setLiveServer(false);
    }

    liveBtn.addEventListener('click', () => {
      if (liveOpen) leaveLive(); else enterLive();
    });
    liveLeave.addEventListener('click', leaveLive);

    function getRecognition() {
      const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (!SR) return null;
      if (recognition) return recognition;
      recognition = new SR();
      recognition.lang = liveLanguage || 'en-US';
      recognition.interimResults = true;
      recognition.continuous = false;
      recognition.onstart = () => {
        liveBusy = true;
        setWave('listen');
        liveTalk.textContent = 'Listening…';
        liveTranscript.textContent = 'Listening…';
      };
      recognition.onresult = (ev) => {
        let interim = '', final = '';
        for (let i = ev.resultIndex; i < ev.results.length; i++) {
          const t = ev.results[i][0].transcript;
          if (ev.results[i].isFinal) final += t; else interim += t;
        }
        liveTranscript.textContent = final || interim || '…';
        if (final) {
          stopRecognition();
          runLiveTurn(final.trim());
        }
      };
      recognition.onerror = (ev) => {
        liveBusy = false;
        liveTalk.textContent = 'Talk';
        setWave('idle');
        liveMeta.textContent = 'Mic error: ' + (ev.error || 'unknown') +
          ' — allow microphone for this site, or type in chat.';
      };
      recognition.onend = () => {
        liveTalk.textContent = 'Talk';
        if (!liveBusy) setWave('idle');
      };
      return recognition;
    }

    function stopRecognition() {
      try { if (recognition) recognition.stop(); } catch (_) {}
      liveBusy = false;
      liveTalk.textContent = 'Talk';
    }

    async function runLiveTurn(message) {
      if (!message) return;
      liveBusy = true;
      liveTalk.disabled = true;
      liveReply.textContent = 'Thinking…';
      setWave('idle');
      addBubble('user', message);
      try {
        const r = await fetch('/voice/turn', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message, history, speak: true, source: 'browser', language: liveLanguage }),
        });
        const j = await r.json();
        if (!r.ok) throw new Error(j.detail || JSON.stringify(j));
        history = j.history || history;
        const reply = j.reply || '(empty)';
        liveReply.textContent = reply;
        addBubble('assistant', reply, ['live', (j.audio && j.audio.provider) || 'tts']);
        const url = (j.audio && j.audio.url) ? j.audio.url : null;
        if (url) playHostAudio(url);
        else liveMeta.textContent = 'No audio: ' + JSON.stringify(j.audio);
        for (const s of (j.screenshots || [])) {
          const name = (s.path || '').split('/').pop();
          const shotUrl = '/demo/' + name + '?t=' + Date.now();
          setLive(shotUrl, name);
          pushHistoryShot(shotUrl, name);
        }
        if (j.audio && j.audio.provider) {
          liveMeta.textContent = 'TTS ' + j.audio.provider + ' · ' + (j.audio.language || liveLanguage) + ' · ' + (j.audio.voice || '') + ' · ' + (j.audio.ms || '?') + 'ms · laptop speakers';
        }
      } catch (err) {
        liveReply.textContent = 'Error: ' + err.message;
        addBubble('assistant', 'Error: ' + err.message, ['error']);
      } finally {
        liveBusy = false;
        liveTalk.disabled = false;
        liveTalk.textContent = 'Talk';
      }
    }

    liveTalk.addEventListener('click', () => {
      const rec = getRecognition();
      if (!rec) {
        liveMeta.textContent = 'Web Speech API unavailable — use Chrome/Edge, or type in chat.';
        const fallback = prompt('Live mic unavailable. Type what you would say:');
        if (fallback) {
          liveTranscript.textContent = fallback;
          runLiveTurn(fallback.trim());
        }
        return;
      }
      try {
        // Unlock audio on user gesture
        if (!liveAudio) {
          liveAudio = new Audio();
          liveAudio.play().catch(() => {});
        }
        rec.start();
      } catch (e) {
        liveMeta.textContent = 'Could not start mic: ' + e.message;
      }
    });

    // Prefetch voice status
    fetch('/voice/status').then(r => r.json()).then(j => {
      if (j && j.provider) {
        liveMeta.textContent = 'TTS ready: ' + j.provider + ' (' + (j.edge_voice || '') + ')';
      }
    }).catch(() => {});

  </script>

  <div id="liveOverlay" role="dialog" aria-modal="true" aria-label="Live voice session">
    <div class="live-card">
      <h2>Live with Strlix</h2>
      <p class="sub">Laptop mic → Strlix → reply plays on <strong>this laptop’s speakers</strong>. Phone stays silent.</p>
      <div class="live-lang-row">
        <label for="liveLang">Language</label>
        <select id="liveLang" aria-label="Live voice language"></select>
      </div>
      <div class="wave idle" id="liveWave" aria-hidden="true">
        <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
      </div>
      <div id="liveTranscript">Tap Talk and speak…</div>
      <div id="liveReply"></div>
      <div class="live-actions">
        <button type="button" id="liveTalk">Talk</button>
        <button type="button" id="liveLeave">Leave</button>
      </div>
      <div id="liveMeta">Audio: host TTS → browser WebAudio · scrcpy --no-audio</div>
    </div>
  </div>

</body>
</html>
